# syntax=docker.io/docker/dockerfile:1
# Preproducción CNIG (defaults embebidos).
# Puerto 8280. Soporta proxy HTTP del build.
# Igual que Dockerfile.cnig salvo el portal: http://192.168.193.167:8180
#
#   export HTTP_PROXY=... HTTPS_PROXY=... NO_PROXY=...
#   docker build -f Dockerfile.pre.cnig \
#     --build-arg HTTP_PROXY=$HTTP_PROXY \
#     --build-arg HTTPS_PROXY=$HTTPS_PROXY \
#     --build-arg NO_PROXY=$NO_PROXY \
#     -t gneis-front-visualizador:pre .
#
#   docker run -d --name gneis-visualizador --restart unless-stopped \
#     -p 8280:8280 gneis-front-visualizador:pre

##########################
# STAGE 0: Base image
##########################
FROM node:22.17.0-alpine AS base

##########################
# STAGE 1: Install dependencies
##########################
FROM base AS deps

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=$HTTP_PROXY \
	HTTPS_PROXY=$HTTPS_PROXY \
	NO_PROXY=$NO_PROXY

RUN apk add --no-cache libc6-compat

WORKDIR /viewer

COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* .npmrc* ./

RUN \
	if [ -f yarn.lock ]; then yarn --frozen-lockfile; \
	elif [ -f package-lock.json ]; then npm ci; \
	elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
	else echo "Lockfile not found." && exit 1; \
	fi

##########################
# STAGE 2: Build application
##########################
FROM base AS builder

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ARG NEXT_PUBLIC_API_IDEE_URL=https://componentes-desarrollo.idee.es/api-idee
ARG NEXT_PUBLIC_API_IDEE_PLUGINS_URL=https://componentes-desarrollo.idee.es/api-idee
ARG NEXT_PUBLIC_GNEIS_PORTAL_URL=http://192.168.193.167:8180
ARG NEXT_PUBLIC_GNEIS_STAC_URL=https://stac-gneis.idee.es
ARG NEXT_PUBLIC_GNEIS_DOWNLOAD_URL=https://stac-gneis.idee.es/download-service/v1/download-jobs
ARG NEXT_PUBLIC_ASSET_VERSION=1
ARG PAGE_TITLE=Visualizador GNEIS

ENV HTTP_PROXY=$HTTP_PROXY \
	HTTPS_PROXY=$HTTPS_PROXY \
	NO_PROXY=$NO_PROXY \
	NEXT_TELEMETRY_DISABLED=1 \
	NEXT_PUBLIC_API_IDEE_URL=$NEXT_PUBLIC_API_IDEE_URL \
	NEXT_PUBLIC_API_IDEE_PLUGINS_URL=$NEXT_PUBLIC_API_IDEE_PLUGINS_URL \
	NEXT_PUBLIC_GNEIS_PORTAL_URL=$NEXT_PUBLIC_GNEIS_PORTAL_URL \
	NEXT_PUBLIC_GNEIS_STAC_URL=$NEXT_PUBLIC_GNEIS_STAC_URL \
	NEXT_PUBLIC_GNEIS_DOWNLOAD_URL=$NEXT_PUBLIC_GNEIS_DOWNLOAD_URL \
	NEXT_PUBLIC_ASSET_VERSION=$NEXT_PUBLIC_ASSET_VERSION \
	PAGE_TITLE=$PAGE_TITLE

WORKDIR /viewer

COPY --from=deps /viewer/node_modules ./node_modules
COPY . .

RUN \
	if [ -f yarn.lock ]; then yarn run build; \
	elif [ -f package-lock.json ]; then npm run build; \
	elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
	else echo "Lockfile not found." && exit 1; \
	fi

##########################
# STAGE 3: Production runner
##########################
FROM node:22.17.0-alpine AS runner

ENV NODE_ENV=production \
	PORT=8280 \
	HOSTNAME=0.0.0.0

WORKDIR /viewer

COPY --from=builder /viewer/public ./public
COPY --from=builder /viewer/.next/standalone ./
COPY --from=builder /viewer/.next/static ./.next/static

EXPOSE 8280

CMD ["node", "server.js"]
